# Kopieren nach .env und anpassen. Die Datei .env nie einchecken.

# Admin-Konto und API-Schluessel werden beim ersten Aufruf im Browser eingerichtet (Einrichtungsassistent).
# Die folgenden Werte sind nur noetig, wenn du das lieber hier festlegst.

# Anthropic-API-Schluessel. Leer = in der App hinterlegen (Benutzerverwaltung -> Einstellungen).
# Gesetzt = hat Vorrang und ist in der Oberflaeche nicht aenderbar.
ANTHROPIC_API_KEY=
# Leer = in der App waehlbar (Standard claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Nur fuer automatisierte Installationen: legt statt des Assistenten ein Konto "admin" mit diesem
# Startpasswort an (muss beim ersten Login geaendert werden).
ADMIN_INITIAL_PASSWORD=
# Einrichtungsassistent auch aus dem Internet erlauben (Standard: nur LAN/VPN). Nach der Einrichtung entfernen.
SETUP_ALLOW_PUBLIC=

# Oeffentliche Adresse, z. B. https://mess.example.de – fuer Einladungs- und Reset-Links hinter einem Proxy
PUBLIC_URL=
# auto = Secure-Cookie bei HTTPS (X-Forwarded-Proto), true/false erzwingt
COOKIE_SECURE=auto
# Adressen des Reverse-Proxys, dessen X-Forwarded-For/-Proto geglaubt wird (IPs oder Netze).
# Standard: Proxy auf dem Host oder in einem Docker-Netz. Nie "*" setzen, sonst laesst sich die
# Login-Sperre mit gefaelschten Adressen umgehen.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# Port auf dem Host. 127.0.0.1 = nur lokal (Reverse-Proxy davor); 0.0.0.0 = im ganzen Netz
BIND_ADDRESS=127.0.0.1
PORT=8000

# CAD-Laeufe pro Benutzer und Monat (Admins unbegrenzt; pro Benutzer in der Verwaltung aenderbar)
DEFAULT_QUOTA=20
MAX_AUTOFIX=2
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_MB=25
SESSION_DAYS=30

# Sandbox-Grenzen je Lauf
SANDBOX_TIMEOUT=120
SANDBOX_MEM_MB=3072
SANDBOX_WORKERS=2
SANDBOX_CONTAINER_MEM=6g
SANDBOX_CPUS=2
# Groesse des gemeinsamen Arbeitsbereichs (RAM, nur waehrend eines Laufs belegt)
RUNS_TMPFS_SIZE=2g
